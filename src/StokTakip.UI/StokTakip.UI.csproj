<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StokTakip</RootNamespace>
    <AssemblyName>StokTakip</AssemblyName>
    <ProjectGuid>{6F37DD0D-5D55-48E5-B1C5-A0975C761B03}</ProjectGuid>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>..\..\assets\logo\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Assembly bilgileri (eski Properties\AssemblyInfo.cs'ten taşındı) -->
  <PropertyGroup>
    <AssemblyTitle>StokTakip</AssemblyTitle>
    <Product>StokTakip</Product>
    <Company></Company>
    <Description></Description>
    <Copyright>Copyright ©  2025</Copyright>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StokTakip.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StokTakip.Domain\StokTakip.Domain.csproj" />
    <ProjectReference Include="..\StokTakip.Application\StokTakip.Application.csproj" />
    <ProjectReference Include="..\StokTakip.Data\StokTakip.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo\logo-64.png" LogicalName="StokTakip.logo-64.png" Link="Resources\logo-64.png" />
    <EmbeddedResource Include="..\..\assets\logo\app.ico" LogicalName="StokTakip.app.ico" Link="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
